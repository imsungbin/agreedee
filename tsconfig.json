{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // NodeNext rather than Bundler on purpose: nothing bundles this code, so
    // extensionless imports must be a compile error, not a runtime 404.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    // Emitted JavaScript must be the source with the types removed and
    // nothing else. This is also what lets `node --test` run the .ts files.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "chrome"]
  },
  "include": ["src/**/*.ts"]
}
